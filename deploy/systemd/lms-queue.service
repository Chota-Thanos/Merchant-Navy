# Background jobs: emails, PDF processing, AI question reading.
# Install:  sudo cp lms-queue.service /etc/systemd/system/ && sudo systemctl enable --now lms-queue
[Unit]
Description=LMS queue worker
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/lms/backend
ExecStart=/usr/bin/php artisan queue:work --sleep=3 --tries=2 --timeout=3600 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
