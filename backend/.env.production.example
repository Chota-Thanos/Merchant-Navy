# Copy to backend/.env on the server and fill in. See docs/DEPLOYMENT.md.
APP_NAME="My Merchant Navy"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                       # run: php artisan key:generate
APP_URL=https://api.mymerchantnavy.com

# Admin panel on its own address (leave out for local development)
ADMIN_DOMAIN=admin.mymerchantnavy.com
STUDENT_APP_URL=https://dashboard.mymerchantnavy.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mmp_lms
DB_USERNAME=lms
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database      # needs the lms-queue service running
FILESYSTEM_DISK=local

# --- Real SMS login. NEVER set OTP_FIXED_CODE in production. ---
OTP_DRIVER=twilio
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Email (course assigned, result ready, live class reminders) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@mymerchantnavy.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Student limits ---
LMS_MAX_DEVICES=2

# --- AI question reader: set ONE key (optional) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_PROVIDER=auto

# --- Reading PDFs (pip install pymupdf). Set if python is not on the PATH ---
# LMS_PYTHON=/usr/bin/python3
